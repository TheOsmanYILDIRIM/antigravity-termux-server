#!/data/data/com.termux/files/usr/bin/bash
set -u
PROMPT="${*:-Sadece TAMAM yaz.}"
AGY_BIN="/data/data/com.termux/files/usr/bin/agy"
OUT_DIR="/data/data/com.termux/files/home"
STAMP="$(date +%s)"
REPORT="$OUT_DIR/agy_runtime_compare_${STAMP}.log"

run_case() {
  local name="$1"; shift
  local out="$OUT_DIR/.agy_compare_${name}_${STAMP}.out"
  local err="$OUT_DIR/.agy_compare_${name}_${STAMP}.err"
  rm -f "$out" "$err"
  local start_ns end_ns first_ms total_ms pid
  start_ns=$(date +%s%N)

  "$@" >"$out" 2>"$err" &
  pid=$!

  first_ms=""
  for _ in $(seq 1 1200); do
    if [ -s "$out" ] || [ -s "$err" ]; then
      local now_ns
      now_ns=$(date +%s%N)
      first_ms=$(( (now_ns - start_ns) / 1000000 ))
      break
    fi
    if ! kill -0 "$pid" 2>/dev/null; then break; fi
    sleep 0.05
  done

  wait "$pid"
  local rc=$?
  end_ns=$(date +%s%N)
  total_ms=$(( (end_ns - start_ns) / 1000000 ))
  [ -z "$first_ms" ] && first_ms="-1"

  {
    echo "CASE=$name"
    echo "FIRST_OUTPUT_MS=$first_ms"
    echo "TOTAL_MS=$total_ms"
    echo "EXIT=$rc"
    echo "STDOUT_HEAD:"
    head -c 500 "$out"; echo
    echo "STDERR_HEAD:"
    head -c 500 "$err"; echo
    echo "----"
  } | tee -a "$REPORT"
}

echo "AGY runtime karşılaştırması" | tee "$REPORT"
echo "Prompt: $PROMPT" | tee -a "$REPORT"
echo | tee -a "$REPORT"

BASE_ARGS=("-p" "$PROMPT" "--dangerously-skip-permissions" "--output-format" "stream-json" "--print-timeout" "60m")

echo "1/3 Normal terminal koşulu..."
run_case normal "$AGY_BIN" "${BASE_ARGS[@]}"

echo "2/3 Server'ın miras aldığı nice=10 koşulu..."
run_case nice10 nice -n 10 "$AGY_BIN" "${BASE_ARGS[@]}"

echo "3/3 Server'ın tam koşulu: nice=10 + taskset 0-5..."
run_case server_like nice -n 10 taskset -c 0-5 "$AGY_BIN" "${BASE_ARGS[@]}"

echo
echo "=== KARŞILAŞTIRMA ==="
grep -E '^(CASE|FIRST_OUTPUT_MS|TOTAL_MS|EXIT)=' "$REPORT"
echo
echo "Rapor: $REPORT"
