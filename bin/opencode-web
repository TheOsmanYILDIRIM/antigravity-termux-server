#!/data/data/com.termux/files/usr/bin/bash
set -u

SESSION_NAME="opencode-web"
OPENCODE_BIN="/data/data/com.termux/files/usr/bin/opencode"
TMUX_BIN="/data/data/com.termux/files/usr/bin/tmux"
TASKSET_BIN="/data/data/com.termux/files/usr/bin/taskset"
NICE_BIN="/data/data/com.termux/files/usr/bin/nice"

case "${1:-}" in
  start)
    if "$TMUX_BIN" has-session -t "$SESSION_NAME" 2>/dev/null; then
      echo "OpenCode servisi zaten çalışıyor (tmux: $SESSION_NAME)"
    else
      "$TMUX_BIN" new-session -d -s "$SESSION_NAME" -c "/data/data/com.termux/files/home" \
        "$NICE_BIN -n 15 $TASKSET_BIN -c 0-5 $OPENCODE_BIN serve --hostname 127.0.0.1 --port 4096"
      if "$TMUX_BIN" has-session -t "$SESSION_NAME" 2>/dev/null; then
        echo "OpenCode servisi başlatıldı (http://127.0.0.1:4096)"
      else
        echo "OpenCode servisi başlatılamadı" >&2
        exit 1
      fi
    fi
    ;;
  stop)
    if "$TMUX_BIN" has-session -t "$SESSION_NAME" 2>/dev/null; then
      "$TMUX_BIN" kill-session -t "$SESSION_NAME"
      echo "OpenCode servisi durduruldu"
    else
      echo "OpenCode servisi çalışmıyor"
    fi
    ;;
  *) echo "Kullanım: $0 {start|stop}" >&2; exit 2 ;;
esac
