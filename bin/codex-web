#!/data/data/com.termux/files/usr/bin/bash
set -u

SESSION_NAME="codex-web"
CODEX_BIN="/data/data/com.termux/files/usr/bin/codex"
TMUX_BIN="/data/data/com.termux/files/usr/bin/tmux"
TASKSET_BIN="/data/data/com.termux/files/usr/bin/taskset"
NICE_BIN="/data/data/com.termux/files/usr/bin/nice"

case "${1:-}" in
  start)
    if "$TMUX_BIN" has-session -t "$SESSION_NAME" 2>/dev/null; then
      echo "Codex servisi zaten çalışıyor (tmux: $SESSION_NAME)"
    else
      "$TMUX_BIN" new-session -d -s "$SESSION_NAME" -c "/data/data/com.termux/files/home" \
        "$NICE_BIN -n 15 $TASKSET_BIN -c 0-5 $CODEX_BIN app-server --listen ws://127.0.0.1:4500"
      if "$TMUX_BIN" has-session -t "$SESSION_NAME" 2>/dev/null; then
        echo "Codex servisi başlatıldı (ws://127.0.0.1:4500)"
      else
        echo "Codex servisi başlatılamadı" >&2
        exit 1
      fi
    fi
    ;;
  stop)
    if "$TMUX_BIN" has-session -t "$SESSION_NAME" 2>/dev/null; then
      "$TMUX_BIN" kill-session -t "$SESSION_NAME"
      echo "Codex servisi durduruldu"
    else
      echo "Codex servisi çalışmıyor"
    fi
    ;;
  *) echo "Kullanım: $0 {start|stop}" >&2; exit 2 ;;
esac
