# Dedicated Supabase project for the Antigravity ChatGPT Agent Bridge.
ANTIGRAVITY_BRIDGE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Public project key. Safe to distribute; access is still gated by the device bridge secret.
ANTIGRAVITY_BRIDGE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Generate this only on the Termux device. Never commit or share the raw value.
ANTIGRAVITY_BRIDGE_CLIENT_SECRET=REPLACE_WITH_LOCAL_RANDOM_SECRET

# Stable identifier for this Termux device/worker.
ANTIGRAVITY_BRIDGE_WORKER_ID=termux-main

# Existing Antigravity Termux Server.
ANTIGRAVITY_BASE_URL=http://127.0.0.1:8080

# Optional tuning.
ANTIGRAVITY_BRIDGE_POLL_MS=3000
ANTIGRAVITY_BRIDGE_HEARTBEAT_MS=20000
ANTIGRAVITY_BRIDGE_LEASE_SECONDS=120
ANTIGRAVITY_BRIDGE_JOB_TIMEOUT_MS=3900000
